# 复制为 .env 后填写；.env 不入 Git
# ===== LLM =====
LLM_PROVIDER=openai            # 或其他 OpenAI 兼容服务
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=your-model-name

# ===== Embedding（若使用 API 服务则填写；本地模型留空）=====
EMBED_MODEL=bge-m3
EMBED_API_KEY=

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000
