# 复制为 .env 后填写；.env 不入 Git
# ===== LLM =====
LLM_PROVIDER=openai            # 或其他 OpenAI 兼容服务
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=your-model-name

# ===== Embedding（若使用 API 服务则填写；本地模型留空）=====
EMBED_MODEL=bge-m3
EMBED_API_KEY=

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== 问答管线模式 =====
RAG_MODE=mock                  # mock=确定性假数据（无需检索/生成实现即可联调前端）；live=接真实实现
QUERY_TOP_K=5                  # /query 未显式传 top_k 时的默认检索条数
CORS_ORIGINS=*                 # 允许的前端来源，逗号分隔；上线前应收紧
