# 复制为 .env 后填写；.env 不入 Git
# ===== LLM =====
# 经 OpenRouter（OpenAI 兼容协议）调大模型，可选免费/低价档。
# 换其他 OpenAI 兼容服务（DeepSeek 直连 / Qwen / Moonshot…）只需改 BASE_URL 与 MODEL。
LLM_PROVIDER=openai            # 协议：OpenAI 兼容（实际服务商由 BASE_URL 指定）
LLM_BASE_URL=https://openrouter.ai/api/v1   # OpenRouter 网关
LLM_API_KEY=sk-or-v1-xxxx      # 换成你的 OpenRouter API Key（openrouter.ai/keys）
LLM_MODEL=minimax/minimax-m3:free   # 免费档 MiniMax M3（2026-08 实测可用）；:free=免费但限速
# 换模型：openrouter.ai/models 勾选 ":free" 筛免费档——清单频繁变动（DeepSeek/Qwen/Llama 免费档已下架）。
# 免费档会被 429 限流，可多试几个或稍后重试；要稳定上量换付费档（只改 MODEL 即可）。
# 注意：勿选 reasoning 模型（deepseek-r1 / o1 等长推理），不适合"仅依据检索作答"的接地场景。

# —— 本地 Ollama（可选后端）——
# 需先起 Ollama（11434）与网关：python models/llm_gateway.py（监听 127.0.0.1:11500）
# 网关存在的原因：把 OpenAI 兼容请求转成 Ollama 原生 /api/chat 并强制 think=false
# （0.33.x 的兼容层会静默丢弃 think 参数，思考 token 会让首字延迟翻倍）。
# LLM_BASE_URL=http://127.0.0.1:11500/v1
# LLM_API_KEY=ollama            # 网关不校验，占位即可（LLM_API_KEY 仍必填）
# LLM_MODEL=qwen3.5-9b          # 与 `ollama list` 里的名字一致

# ===== Embedding（若使用 API 服务则填写；本地模型留空）=====
EMBED_MODEL=bge-m3
EMBED_API_KEY=
# 权重已在本地缓存时，导出 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1（否则初始化会反复联网取文件而看似卡死）；
# 需重新下载时请直连 huggingface.co——设 HF_ENDPOINT 走镜像在本机实测会 FileMetadataError。
# 缓存位置（易踩坑）：embedding 权重在 LlamaIndex 缓存（Windows 为 %LOCALAPPDATA%\llama_index\llama_index\Cache，
# 因为 LlamaIndex 会显式传自己的 cache_dir），精排 bge-reranker-v2-m3 在 HF 默认缓存（~/.cache/huggingface）。
# Docker 形态下这两处由 docker-compose.yml 分别挂载，见 README「Docker 打包与部署」。
#
# 另：容器侧需要与宿主不同的配置时，写进同目录的 .env.docker（不入 Git，优先级高于本文件）。
# 典型用法——本地 LLM 的地址在容器里不能用 127.0.0.1（那指容器自身）：
#   # .env.docker
#   LLM_BASE_URL=http://host.docker.internal:11500/v1

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== 问答管线模式 =====
RAG_MODE=mock                  # mock=确定性假数据（无需检索/生成实现即可联调前端）；live=接真实实现
QUERY_TOP_K=5                  # /query 未显式传 top_k 时的默认检索条数
CORS_ORIGINS=*                 # 允许的前端来源，逗号分隔；上线前应收紧
RAG_EXPERIMENT_CONFIG=configs/experiments/struct_v1.yaml   # live 模式定位索引/embedding 的实验配置（相对仓库根）
LOG_DIR=logs                   # 日志落盘目录（相对仓库根或绝对路径；不入 Git）。请求级 requests.jsonl / 检索级 retrievals.jsonl（live 模式，字段见 docs/retrieval-log-schema.md）/ 引用回查 sources.jsonl 均在此
SOURCES_CACHE_SIZE=100         # /sources 持久化存储的内存读取窗口上限（全量记录在 {LOG_DIR}/sources.jsonl）
